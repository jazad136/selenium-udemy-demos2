    "steps": [
      {
        "stepNumber": 1,
        "action": "Navigate",
        "target": "https://opensource-demo.orangehrmlive.com/",
        "expected": [
          "Login page loads successfully",
          "Login form is visible"
        ]
      },
      {
        "stepNumber": 2,
